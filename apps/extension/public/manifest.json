{
  "manifest_version": 3,
  "name": "ResearchFlow",
  "version": "0.1.0",
  "description": "在浏览器侧栏阅读、研究并整理技术资料。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab"],
  "host_permissions": ["http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ResearchFlow"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

